+    function normalizeImageUrl(url) {
+        if (!url) return '';
+        if (url.includes('supabase.co/storage/v1/object/public/images/')) {
+            return url.replace(/https?:\/\/.*\.supabase\.co\/storage\/v1\/object\/public\/images\//, 'https://www.felekmangalbasi.com/images/');
+        }
+        return url;
+    }
