+
+/* ==========================================================================
+   IN-CARD QUOTE + ARCHIVE LIST (press wall)
+   ========================================================================== */
+
+.land-card-quote {
+  font-family: var(--serif);
+  font-style: italic;
+  font-weight: 400;
+  font-size: 1.05rem;
+  line-height: 1.6;
+  color: var(--text);
+  margin-top: 1rem;
+  border-left: 1px solid var(--border);
+  padding-left: 1rem;
+}
+
+.land-archive {
+  list-style: none;
+  margin-top: 1rem;
+  display: flex;
+  flex-direction: column;
+  gap: 0.9rem;
+}
+
+.land-archive li {
+  font-size: 14px;
+  line-height: 1.75;
+  font-weight: 300;
+  color: var(--muted);
+  padding-left: 1rem;
+  border-left: 1px solid var(--border);
+}
+
+.land-archive strong {
+  color: var(--text);
+  font-weight: 400;
+  display: block;
+}
+
+.land-archive a {
+  display: inline-block;
+  margin-top: 0.35rem;
+  font-size: 11px;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--accent);
+}
+
+.land-archive a:hover { color: var(--text); }
