+}
+
+.land-table tbody tr:hover {
+  background: rgba(200, 146, 58, 0.04);
+}
+
+.land-table td {
+  color: var(--muted);
+}
+
+.land-table td:first-child {
+  color: var(--text);
+  font-weight: 400;
+  white-space: nowrap;
+}
+
+/* Highlight the "Felek" column in comparison tables */
+.land-table .is-felek {
