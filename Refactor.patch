+}
+
+.land-cta-title {
+  font-family: var(--serif);
+  font-weight: 300;
+  font-size: clamp(2.4rem, 5vw, 4rem);
+  line-height: 1;
+  margin-bottom: 1.5rem;
+}
+
+.land-cta-title em {
+  font-style: italic;
+  color: var(--accent);
+}
+
+.land-cta-sub {
+  color: var(--muted);
+  max-width: 46ch;
+  margin: 0 auto;
+  font-size: 1rem;
+  line-height: 1.7;
+  font-weight: 300;
+}
+
+/* ==========================================================================
+   RESPONSIVE
+   ========================================================================== */
+
+@media (max-width: 900px) {
