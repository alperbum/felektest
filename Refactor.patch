+    cachedItemList.every(i => /\u20ba/.test(i.price)), cachedItemList[0].price);
+
+  const e2 = realErrors(env2.jsErrors);
+  check('KATMAN 2: calisma zamani JS hatasi yok', e2.length === 0, e2.slice(0, 3).join(' | '));
+  w2.close();
+
+  /* -------------------------------------------------------------------- */
+  console.log('\n--- KATMAN 3: geri bildirim formu (api/feedback.php) ---');
+  const env3 = makeDom();
+  const w3 = env3.window, d3 = env3.document;
+  let req = null;
+  let responder = () => Promise.resolve({ ok: true, json: () => Promise.resolve({ ok: true }) });
+  await boot(env3, {
+    supabase: false,
+    fetchImpl: () => (url, opts) => {
+      req = { url: String(url), opts: opts || {} };
+      return responder();
+    }
+  });
+  await sleep(120);
+
+  const form = d3.getElementById('feedback-form');
+  const fName = d3.getElementById('feedback-name');
+  const fMsg = d3.getElementById('feedback-msg');
+  const fBtn = d3.getElementById('feedback-submit');
+  const fStatus = d3.getElementById('feedback-status');
+  const fCount = d3.getElementById('feedback-char-count');
+  check('form ve alanlar mevcut', !!form && !!fName && !!fMsg && !!fBtn && !!fStatus && !!fCount);
+  check('durum alani ekran okuyucuya duyuruluyor (role=status)', fStatus.getAttribute('role') === 'status'
+    && fStatus.getAttribute('aria-live') === 'polite');
+
+  // --- baslangic durumu: degerler DEGISTIRILMEDEN once kontrol edilmeli ---
+  check('textarea varsayilan degerle DOLU gelmiyor', fMsg.value === '',
+    JSON.stringify(fMsg.value));
+  check('baslangicta sayac 2000 / 2000', fCount.textContent === '2000 / 2000', fCount.textContent);
+  check('form alani zorunlu (required)', fMsg.hasAttribute('required'));
+  check('placeholder metni var', (fMsg.getAttribute('placeholder') || '').length > 0);
+
+  function submit() {
+    form.dispatchEvent(new w3.Event('submit', { bubbles: true, cancelable: true }));
+    return sleep(60);
+  }
+
+  // bos mesaj -> istek atilmamali
+  req = null;
+  fMsg.value = '   ';
+  await submit();
+  check('bos mesajda istek atilmiyor', req === null);
+
+  // karakter sayaci
+  fMsg.value = 'x'.repeat(10);
+  fMsg.dispatchEvent(new w3.Event('input', { bubbles: true }));
+  check('karakter sayaci guncelleniyor', fCount.textContent === '1990 / 2000', fCount.textContent);
+
+  // basarili gonderim
+  req = null;
+  fName.value = 'Deneme';
+  fMsg.value = 'Servis cok iyiydi';
+  await submit();
+  check('istek dogru uca gitti (api/feedback.php)', req && req.url === 'api/feedback.php', req && req.url);
+  check('istek POST', req && req.opts.method === 'POST', req && req.opts.method);
+  check('govde JSON', req && /application\/json/.test((req.opts.headers || {})['Content-Type'] || ''));
+  let payload = {};
+  try { payload = JSON.parse(req.opts.body); } catch (e) { /* asagida yakalanir */ }
+  check('govdede name+message var', payload.name === 'Deneme' && payload.message === 'Servis cok iyiydi',
+    JSON.stringify(payload));
+  check('Istemci isteginde Telegram token deseni yok', !/\d{9,10}:[A-Za-z0-9_-]{30,}/.test(req.opts.body || ''));
+  check('basarida is-success sinifi', fStatus.classList.contains('is-success'), fStatus.className);
+  check('basarida mesaj gosterildi', fStatus.textContent.trim().length > 0, fStatus.textContent);
+  check('basarida form sifirlandi', fMsg.value === '');
+  check('basarida sayac sifirlandi', fCount.textContent === '2000 / 2000', fCount.textContent);
+  check('basarida buton tekrar aktif', fBtn.disabled === false && fBtn.textContent.trim().length > 0,
+    fBtn.disabled + ' / ' + fBtn.textContent);
+
+  // sunucu hatasi (ok:false)
+  responder = () => Promise.resolve({ ok: true, json: () => Promise.resolve({ ok: false, error: 'upstream_failed' }) });
+  fMsg.value = 'ikinci deneme';
+  await submit();
+  check('ok:false durumunda is-error sinifi', fStatus.classList.contains('is-error'), fStatus.className);
+  check('ok:false durumunda buton tekrar aktif', fBtn.disabled === false);
+
+  // PHP kurulu degil -> IIS 404 (JSON olmayan govde)
+  responder = () => Promise.resolve({ ok: false, status: 404, json: () => Promise.reject(new Error('HTML')) });
+  fMsg.value = 'ucuncu deneme';
+  await submit();
+  check('404 (PHP yok) durumunda is-error sinifi', fStatus.classList.contains('is-error'), fStatus.className);
+  check('404 sonrasi buton kilitli kalmiyor', fBtn.disabled === false);
+
+  // 503 not_configured
+  responder = () => Promise.resolve({ ok: false, status: 503, json: () => Promise.resolve({ ok: false, error: 'not_configured' }) });
+  fMsg.value = 'dorduncu deneme';
+  await submit();
+  check('503 (token tanimsiz) durumunda is-error sinifi', fStatus.classList.contains('is-error'), fStatus.className);
+
+  // ag hatasi
+  responder = () => Promise.reject(new Error('offline'));
+  fMsg.value = 'besinci deneme';
+  await submit();
+  check('ag hatasinda is-error sinifi', fStatus.classList.contains('is-error'), fStatus.className);
+
+  // KATMAN 3 bilerek hata yollarini deniyor; burada console.error bekleniyor.
+  // Yakalanmamis istisna (jsdomError) olmamasi asil kriterdir.
+  check('KATMAN 3: yakalanmamis JS istisnasi yok', realErrors(env3.uncaught).length === 0,
+    realErrors(env3.uncaught).slice(0, 2).join(' | '));
+  check('KATMAN 3: hata yollari sessizce yutulmuyor (loglaniyor)',
+    env3.jsErrors.some(e => e.includes('Geri bildirim gonderilemedi') || e.includes('Geri bildirim gönderilemedi')));
+  w3.close();
+
+  /* -------------------------------------------------------------------- */
+  console.log('\n----------------------------------------');
+  console.log(checks + ' kontrol, ' + failures + ' basarisiz');
+  console.log(failures === 0 ? 'TUM KONTROLLER GECTI' : 'BASARISIZ KONTROLLER VAR');
+  process.exit(failures === 0 ? 0 : 1);
+}
+
+main().catch(e => { console.error('TEST HATASI:', e); process.exit(1); });
diff --git a/tests/check-pages.js b/tests/check-pages.js
new file mode 100644
index 0000000..0a04702
--- /dev/null
+++ b/tests/check-pages.js
@@ -0,0 +1,141 @@
+/* ==========================================================================
+   Felek Mangalbasi — sayfa dogrulama testi
+   -------------------------------------------------------------------------
+   Kurulum ve calistirma:
+       npm i jsdom --no-save
+       node tests/check-pages.js
+
+   Ne yapar:
+   1. Her sayfayi jsdom icinde gercek DOM olarak yukler.
+   2. js/site.js'i calistirir ve su kod yollarini dogrular:
+      - #year (footer yili)
+      - IntersectionObserver olmadiginda reveal fallback'i
+      - #menu-toggle click -> #header.active + aria-expanded
+      - nav link click / Escape -> menu kapanmasi
+      - aria-current="page" eslesmesi
+      - .land-faq-item 'toggle' -> tek acik akordeon
+   3. Yapi denetimi: tek <h1>, skip link, 3 sutunlu footer, inline style yok,
+      <style> blogu yok, emoji yok, JSON-LD semasi mevcut.
+
+   Not: IntersectionObserver'li (gercek tarayici) dal icin
+        tests/check-observer.js kullanilir.
+   ========================================================================== */
+const fs = require('fs');
+const path = require('path');
+const { JSDOM } = require('jsdom');
+
+const ROOT = path.join(__dirname, '..');
+const SITE_JS = fs.readFileSync(path.join(ROOT, 'js/site.js'), 'utf8');
+
+const LANDING = ['zahmetsiz-mangal.html', 'raki-mangal-meyhane.html', 'kennedy-sahil-konum.html',
+                 'gurme-yorumlar.html', 'suadiye.html', 'tarihce.html', 'basinda-felek.html'];
+const PAGES = ['index.html', 'menu.html', ...LANDING];
+
+const PICTOGRAPH = /[\u{1F000}-\u{1FAFF}\u2300-\u27BF\u2B00-\u2BFF\uFE0F]/u;
+
+let failures = 0;
+function check(label, cond, extra) {
+  if (cond) console.log('   ok   ' + label);
+  else { console.log('   FAIL ' + label + (extra ? '  -> ' + extra : '')); failures++; }
+}
+
+for (const page of PAGES) {
+  console.log('\n=== ' + page + ' ===');
+  const html = fs.readFileSync(path.join(ROOT, page), 'utf8');
+  const dom = new JSDOM(html, {
+    url: 'https://www.felekmangalbasi.com/' + page,
+    runScripts: 'outside-only',
+    pretendToBeVisual: true,
+  });
+  const { window } = dom;
+  const { document } = window;
+  const errors = [];
+  window.addEventListener('error', e => errors.push(String(e.message)));
+
+  window.eval('document.documentElement.classList.add("js");');
+  window.eval(SITE_JS);
+  document.dispatchEvent(new window.Event('DOMContentLoaded', { bubbles: true }));
+
+  // --- js/site.js code paths ------------------------------------------- //
+  const yearEl = document.getElementById('year');
+  if (yearEl) {
+    check('footer yili guncel yila ayarlandi',
+      yearEl.textContent === String(new Date().getFullYear()), '"' + yearEl.textContent + '"');
+  }
+  const reveals = document.querySelectorAll('.reveal');
+  const visible = document.querySelectorAll('.reveal.visible');
+  check('reveal fallback: ' + reveals.length + ' oge gorunur',
+    reveals.length === 0 || reveals.length === visible.length,
+    reveals.length + ' vs ' + visible.length);
+  check('html.js sinifi eklendi', document.documentElement.classList.contains('js'));
+
+  const header = document.getElementById('header');
+  const toggle = document.getElementById('menu-toggle');
+  if (toggle && header) {
+    check('nav kapali basliyor',
+      !header.classList.contains('active') && toggle.getAttribute('aria-expanded') === 'false');
+    toggle.dispatchEvent(new window.MouseEvent('click', { bubbles: true }));
+    check('hamburger menuyu aciyor',
+      header.classList.contains('active') && toggle.classList.contains('active') &&
+      toggle.getAttribute('aria-expanded') === 'true');
+    toggle.dispatchEvent(new window.MouseEvent('click', { bubbles: true }));
+    check('hamburger menuyu kapatiyor',
+      !header.classList.contains('active') && toggle.getAttribute('aria-expanded') === 'false');
+    toggle.dispatchEvent(new window.MouseEvent('click', { bubbles: true }));
+    header.querySelector('.nav-links a').dispatchEvent(new window.MouseEvent('click', { bubbles: true }));
+    check('nav linki tiklaninca menu kapaniyor', !header.classList.contains('active'));
+    toggle.dispatchEvent(new window.MouseEvent('click', { bubbles: true }));
+    document.dispatchEvent(new window.KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
+    check('Escape menuyu kapatiyor', !header.classList.contains('active'));
+  } else {
+    check('hamburger butonu mevcut', false, '#menu-toggle veya #header yok');
+  }
+
+  const links = [...(header ? header.querySelectorAll('.nav-links a') : [])];
+  const expected = links.filter(a =>
+    (a.getAttribute('href') || '').split('/').pop().split('#')[0] === page).length;
+  const actual = header ? header.querySelectorAll('.nav-links a[aria-current="page"]').length : -1;
+  check('aria-current guncel sayfayla eslesiyor (' + expected + ' beklenen)', actual === expected,
+    'bulunan ' + actual);
+
+  const items = document.querySelectorAll('.land-faq .land-faq-item');
+  if (items.length > 1) {
+    items[0].open = true; items[0].dispatchEvent(new window.Event('toggle'));
+    items[1].open = true; items[1].dispatchEvent(new window.Event('toggle'));
+    const openCount = [...items].filter(i => i.open).length;
+    check('FAQ akordeonu tek acik tutuyor', openCount === 1, openCount + ' acik');
+  }
+
+  // --- structure --------------------------------------------------------- //
+  check('<main> mevcut', !!document.querySelector('main[id]'));
+  check('skip link mevcut', !!document.querySelector('.skip-link'));
+  check('tek <h1>', document.querySelectorAll('h1').length === 1,
+    String(document.querySelectorAll('h1').length));
+  check('footer 3 sutun', document.querySelectorAll('footer > div').length === 3);
+  check('footer site haritasi >= 7 ic link',
+    document.querySelectorAll('.footer-links a').length >= 7,
+    String(document.querySelectorAll('.footer-links a').length));
+  check('inline style yok', !/\sstyle=/.test(html));
+  check('<style> blogu yok', !/<style/.test(html));
+  check('emoji/piktograf yok', !PICTOGRAPH.test(
+    html.replace(/<script[\s\S]*?<\/script>/g, '')));
+  check('JSON-LD semasi var', /application\/ld\+json/.test(html));
+  check('cikis yapan bare & yok',
+    !/&(?!(?:[a-zA-Z][a-zA-Z0-9]{1,30}|#\d{1,6}|#x[0-9a-fA-F]{1,6});)/
+      .test(html.replace(/<script[\s\S]*?<\/script>/g, '')));
+
+  if (LANDING.includes(page)) {
+    check('css/landing.css yukleniyor', /css\/landing\.css/.test(html));
+    check('js/site.js yukleniyor', /js\/site\.js/.test(html));
+    check('BreadcrumbList semasi var', /BreadcrumbList/.test(html));
+    check('WebPage/AboutPage/CollectionPage semasi var',
+      /"@type":\s*"(WebPage|AboutPage|CollectionPage)"/.test(html));
+  }
+
+  check('JS calisma zamani hatasi yok', errors.length === 0, errors.join(' | '));
+  window.close();
+}
+
+console.log('\n----------------------------------------');
+console.log(failures === 0 ? 'TUM KONTROLLER GECTI' : failures + ' KONTROL BASARISIZ');
+process.exit(failures === 0 ? 0 : 1);
diff --git a/tests/check-security.js b/tests/check-security.js
new file mode 100644
index 0000000..7f283b2
--- /dev/null
+++ b/tests/check-security.js
@@ -0,0 +1,153 @@
+/* ==========================================================================
+   Felek Mangalbasi — guvenlik ve paketleme butunlugu testi
+   -------------------------------------------------------------------------
+       node tests/check-security.js
+
+   Neyi korur:
+     1) Yayina giden dosyalarda hardcoded sir (token/sifre/ozel anahtar) olmasi
+     2) Kimlik dosyalarinin git tarafindan takip edilmesi
+     3) Sayfalarin isaret ettigi yerel varliklarin (js/css) var olmasi
+     4) deploy_ftp.py'nin yeni dosyalari allowlist'e almis olmasi
+   ========================================================================== */
+const fs = require('fs');
+const path = require('path');
+const { execSync } = require('child_process');
+
+const ROOT = path.join(__dirname, '..');
+let failures = 0, checks = 0;
+function check(label, cond, extra) {
+  checks++;
+  if (cond) console.log('   ok   ' + label);
+  else { console.log('   FAIL ' + label + (extra !== undefined ? '  -> ' + extra : '')); failures++; }
+}
+const read = rel => fs.readFileSync(path.join(ROOT, rel), 'utf8');
+
+/* --- 1. Yayina giden dosya kumesi --------------------------------------- */
+const deployed = execSync('git ls-files', { cwd: ROOT, encoding: 'utf8' })
+  .split('\n')
+  .filter(Boolean)
+  .filter(f => !f.startsWith('tests/'))
+  // .md dahil: sir sizintisi en cok dokumantasyonda olur (bkz. .agents/AGENTS.md)
+  .filter(f => /\.(html|js|css|php|py|xml|txt|json|md|config)$/.test(f) || f === '_headers' || f === 'robots.txt');
+
+console.log('=== guvenlik ve paketleme testi ===\n');
+console.log('--- 1. hardcoded sir taramasi (' + deployed.length + ' dosya) ---');
+
+const SECRET_PATTERNS = [
+  { name: 'Telegram bot token', re: /\d{9,10}:[A-Za-z0-9_-]{30,}/ },
+  { name: 'Google ozel anahtar blogu', re: /-----BEGIN [A-Z ]*PRIVATE KEY-----/ },
+  { name: 'JSON private_key alani', re: /"private_key"\s*:/ },
+  { name: 'client_email (service account)', re: /"client_email"\s*:\s*"[^"]+@[^"]+\.iam\.gserviceaccount\.com"/ },
+  { name: 'FTP_PASS sabiti', re: /FTP_PASS\s*=\s*['"][^'"]+['"]/ },
+  // Ornek dosyalardaki yer tutucular (BURAYA_*, YOUR_*, CHANGE_ME, ...) sir degildir;
+  // gercek bir token yazilirsa kural yine yakalar.
+  { name: 'gizli anahtar tanimi (const/define)',
+    re: /(?:define|const)\s*\(\s*['"](?:TG_BOT_TOKEN|TG_CHAT_ID)['"]\s*,\s*['"](?!(?:BURAYA|YOUR_|CHANGE|ORNEK|PLACEHOLDER|xxx|XXX))[^'"]+['"]/ },
+];
+
+for (const rule of SECRET_PATTERNS) {
+  const hits = [];
+  for (const rel of deployed) {
+    let content;
+    try { content = read(rel); } catch (e) { continue; }
+    if (rule.re.test(content)) hits.push(rel);
+  }
+  check('sir taramasi: ' + rule.name + ' yok', hits.length === 0, hits.join(', '));
+}
+
+// Bilincli istisna: Supabase "publishable" anahtari tarayiciya gitmek uzere
+// tasarlanmistir (RLS ile korunur). Sir degildir; sadece yorumla belgelenir.
+const cfg = read('js/config.js');
+check('Supabase anahtari publishable/anon tipinde (sir degil)',
+  /sb_publishable_|anon/.test(cfg) && !/service_role/.test(cfg),
+  'service_role anahtari asla istemcide olmamali');
+
+console.log('\n--- 2. kimlik dosyalari git takibinde mi ---');
+let tracked = [];
+try {
+  tracked = execSync('git ls-files', { cwd: ROOT, encoding: 'utf8' }).split('\n').filter(Boolean);
+} catch (e) {
+  console.log('   (git yok, atlandi)');
+}
+for (const sensitive of ['service_account.json', 'keywords.txt', 'gsc_compare.json',
+  'gsc_ve_isletme_profili_keywords.txt', '.env', 'api/config.php']) {
+  check('git takibinde degil: ' + sensitive, !tracked.includes(sensitive));
+}
+// Niyet: "bu dosyalari takipten cikarirken kullanicinin diskinden silmedim".
+// Ama temiz bir klonda bu dosyalar hic var olmamis olabilir; o durumda
+// yokluk bir kayip degildir. Bu yuzden varlik DEGIL, ignore kurali sinanir.
+const credOnDisk = ['service_account.json', 'keywords.txt', 'gsc_compare.json',
+  'gsc_ve_isletme_profili_keywords.txt'].filter(f => fs.existsSync(path.join(ROOT, f)));
+let credAllIgnored = true;
+for (const f of credOnDisk) {
+  try { execSync('git check-ignore -q ' + f, { cwd: ROOT }); }
+  catch (e) { credAllIgnored = false; }
+}
+check('yerelde varsa git tarafindan ignore ediliyor (temiz klonda bos olabilir)',
+  credAllIgnored, credOnDisk.join(', ') || '(bu klonda yok)');
+
+console.log('\n--- 3. .gitignore korumasi ---');
+const gitignore = read('.gitignore');
+for (const pat of ['service_account.json', '.env', 'api/config.php']) {
+  check('.gitignore kapsiyor: ' + pat, gitignore.includes(pat));
+}
+check('.env.example mevcut (ornek dosya gerekli)', fs.existsSync(path.join(ROOT, '.env.example')));
+let envExampleIgnored = false;
+try {
+  execSync('git check-ignore -q .env.example', { cwd: ROOT });
+  envExampleIgnored = true;
+} catch (e) { /* ignore edilmemis -> istenen durum */ }
+check('.env.example git tarafindan ignore EDILMIYOR', !envExampleIgnored);
+
+console.log('\n--- 4. sayfa varlik referanslari ---');
+// admin/ ayri Vite uygulamasi; src/ ise DERLEME KAYNAGI (sablon + front matter).
+// Ikisi de bilincli olarak yayinlanmaz, allowlist'te olmamalari dogrudur.
+const pages = tracked.filter(f => f.endsWith('.html')
+  && !f.startsWith('admin/') && !f.startsWith('src/'));
+for (const page of pages) {
+  const html = read(page);
+  const refs = [
+    ...[...html.matchAll(/<script\s+src="([^"]+)"/g)].map(m => m[1]),
+    ...[...html.matchAll(/<link[^>]+href="([^"]+)"/g)].map(m => m[1]),
+  ]
+    .filter(u => !/^(https?:)?\/\//.test(u) && !u.startsWith('data:'))
+    .filter(u => /\.(js|css)(\?.*)?$/.test(u))
+    .map(u => u.replace(/\?.*$/, ''));
+
+  const missing = [...new Set(refs)].filter(rel => !fs.existsSync(path.join(ROOT, rel)));
+  check(page + ' yerel varlik referanslari mevcut', missing.length === 0, missing.join(', '));
+}
+
+console.log('\n--- 5. deploy_ftp.py allowlist kapsamasi ---');
+const deployPy = read('deploy_ftp.py');
+check('allowlist icinde api/feedback.php', deployPy.includes("'api/feedback.php'"));
+check('allowlist icinde js/feedback.js', deployPy.includes("'js/feedback.js'"));
+check('deploy_ftp.py hardcoded FTP sifresi icermiyor', !/FTP_PASS\s*=\s*['"]/.test(deployPy));
+check('deploy_ftp.py ortam degiskeni/.env okuyor',
+  deployPy.includes('os.environ.get') && deployPy.includes('.env'));
+
+// Her sayfa ve her js/css dosyasi allowlist'te mi?
+const listBlock = deployPy.slice(deployPy.indexOf('CORE_FILES = ['), deployPy.indexOf(']', deployPy.indexOf('CORE_FILES = [')));
+const allowlisted = [...listBlock.matchAll(/'([^']+)'/g)].map(m => m[1]);
+const mustDeploy = [
+  ...pages,
+  ...tracked.filter(f => /^(js|css)\/.*\.(js|css)$/.test(f)),
+];
+// admin/ Vite uygulamasi kapsam disi (web.config ile korunur, bilincli olarak yayinlanmaz)
+const notDeployed = mustDeploy.filter(f => !allowlisted.includes(f));
+check('tum sayfalar ve js/css dosyalari allowlist\'te', notDeployed.length === 0, notDeployed.join(', '));
+
+console.log('\n--- 6. istemcide Telegram cagrisi kalmadi ---');
+for (const page of pages) {
+  const html = read(page);
+  check(page + ' dogrudan Telegram API cagirmiyor', !html.includes('api.telegram.org'));
+}
+check('js/feedback.js ayni kaynak uca POST ediyor',
+  read('js/feedback.js').includes("api/feedback.php"));
+check('_headers CSP connect-src Telegram icermiyor',
+  !/_headers CSP|connect-src[^;\n]*api\.telegram\.org/.test(read('_headers')));
+
+console.log('\n----------------------------------------');
+console.log(checks + ' kontrol, ' + failures + ' basarisiz');
+console.log(failures === 0 ? 'TUM KONTROLLER GECTI' : 'BASARISIZ KONTROLLER VAR');
+process.exit(failures === 0 ? 0 : 1);
diff --git a/tests/run-all.js b/tests/run-all.js
new file mode 100644
index 0000000..ed47445
--- /dev/null
+++ b/tests/run-all.js
@@ -0,0 +1,41 @@
+#!/usr/bin/env node
+/* ==========================================================================
+   Tum test suite'lerini sirayla calistirir.
+       npm test        (veya)   node tests/run-all.js
+   ========================================================================== */
+const { spawnSync } = require('child_process');
+const path = require('path');
+
+const SUITES = [
+  { file: 'check-build.js', label: 'derleme tutarliligi (src/js -> js/script.js)' },
+  { file: 'check-pages.js', label: 'sayfa yapisi ve erisilebilirlik' },
+  { file: 'check-faq.js', label: 'FAQ paritesi (gorunur metin <-> sema)' },
+  { file: 'check-menu.js', label: 'menu davranisi (jsdom)' },
+  { file: 'check-security.js', label: 'guvenlik ve paketleme' },
+];
+
+let failed = 0;
+const results = [];
+
+for (const suite of SUITES) {
+  console.log('\n' + '='.repeat(70));
+  console.log('SUITE: ' + suite.file + '  —  ' + suite.label);
+  console.log('='.repeat(70));
+  const res = spawnSync(process.execPath, [path.join(__dirname, suite.file)], {
+    stdio: 'inherit',
+  });
+  const ok = res.status === 0;
+  if (!ok) failed++;
+  results.push({ file: suite.file, ok });
+}
+
+console.log('\n' + '='.repeat(70));
+console.log('OZET');
+console.log('='.repeat(70));
+for (const r of results) {
+  console.log('  ' + (r.ok ? 'GECTI' : 'BASARISIZ') + '  ' + r.file);
+}
+console.log('\n' + (failed === 0
+  ? 'TUM SUITE\'LER GECTI'
+  : failed + ' suite basarisiz'));
+process.exit(failed === 0 ? 0 : 1);
