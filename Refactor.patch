+  }
+
+  .land-grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .land-answer {
+    padding-left: 1.25rem;
+  }
+
+  .land-faq-item summary {
+    font-size: 1.1rem;
