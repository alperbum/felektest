+  margin-top: 1.25rem;
+  font-size: 11px;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+  color: var(--accent);
+}
+
+/* ==========================================================================
+   DATA TABLE — hairline, no card chrome, matches the site's restraint
+   ========================================================================== */
+
+.land-table-wrap {
