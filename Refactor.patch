+}
+
+.land-review-src {
+  display: block;
+  margin-top: 0.9rem;
+  font-size: 11px;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+/* ==========================================================================
+   STATS
+   ========================================================================== */
+
+.land-stats {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
