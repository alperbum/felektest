+  line-height: 1.65;
+  font-weight: 300;
+}
+
+.land-table thead th {
+  font-size: 11px;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+  color: var(--accent);
+  font-weight: 400;
+  border-bottom: 1px solid var(--border);
