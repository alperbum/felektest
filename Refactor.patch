+/* ==========================================================================
+   FELEK MANGALBAŞI — Editorial / Landing Design System
+   -------------------------------------------------------------------------
+   Shared skin for the SEO & GEO landing pages (tarihce, basinda-felek,
+   zahmetsiz-mangal, raki-mangal-meyhane, kennedy-sahil-konum,
+   gurme-yorumlar, suadiye).
+
+   Rules:
+   1. Never redeclare the design tokens — they come from css/style.css.
+   2. Never reuse a class name that style.css already styles for the
+      homepage/menu chrome (.nav-links, .container, .btn, nav, footer).
+      Every component here is namespaced with `.land-`.
+   3. Only weights 300 / 400 are used for type, exactly like the homepage.
+   ========================================================================== */
+
+/* --- Progressive enhancement: never hide content when JS is unavailable --- */
+html:not(.js) .reveal {
+  opacity: 1;
+  transform: none;
+}
+
+/* ==========================================================================
+   LAYOUT
+   ========================================================================== */
+
+.land-page {
+  padding-top: 6.5rem; /* clears the fixed nav */
+}
+
+.land-wrap {
+  width: 100%;
+  max-width: 1100px;
+  margin: 0 auto;
+  padding: 0 3rem;
+}
+
+.land-wrap--narrow {
+  max-width: 780px;
+}
+
+.land-section {
+  padding: 5.5rem 0;
+  border-top: 1px solid var(--border);
+}
+
+.land-section--first {
+  border-top: none;
+}
+
+.land-section--alt {
+  background: var(--bg2);
+  border-top: 1px solid var(--border);
+}
+
+/* ==========================================================================
+   BREADCRUMB
+   ========================================================================== */
+
+.land-crumb {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.5rem;
+  font-size: 11px;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+  color: var(--muted);
+  margin-bottom: 2.5rem;
+}
+
+.land-crumb a {
+  color: var(--muted);
+}
+
+.land-crumb a:hover {
+  color: var(--accent);
+}
+
+.land-crumb span[aria-hidden] {
+  color: var(--border);
+}
+
+.land-crumb [aria-current="page"] {
+  color: var(--accent);
+}
+
+/* ==========================================================================
+   HERO
+   ========================================================================== */
+
+.land-hero {
+  padding: 3rem 0 5.5rem;
+  position: relative;
+}
+
+.land-hero::after {
+  content: '';
+  position: absolute;
+  top: -30%;
+  right: -10%;
+  width: 620px;
+  height: 620px;
+  border-radius: 50%;
+  background: radial-gradient(circle, rgba(200, 146, 58, 0.07) 0%, transparent 65%);
+  pointer-events: none;
+}
+
+.land-eyebrow {
+  font-size: 11px;
+  letter-spacing: 0.25em;
+  text-transform: uppercase;
+  color: var(--accent);
+  margin-bottom: 2rem;
+}
+
+.land-title {
+  font-family: var(--serif);
+  font-weight: 300;
+  font-size: clamp(2.6rem, 5.5vw, 4.5rem);
+  line-height: 1.02;
+  letter-spacing: -0.01em;
+  max-width: 15ch;
+  margin-bottom: 2rem;
+}
+
+.land-title em {
+  font-style: italic;
+  color: var(--accent);
+}
+
+.land-lede {
+  font-size: 1.0625rem;
+  line-height: 1.75;
+  font-weight: 300;
+  color: var(--muted);
+  max-width: 56ch;
+}
+
+.land-meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 1rem 2.5rem;
+  margin-top: 3rem;
+  padding-top: 2rem;
+  border-top: 1px solid var(--border);
+}
+
+.land-meta-item {
+  font-size: 11px;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+/* ==========================================================================
+   SECTION HEADERS
+   ========================================================================== */
+
+.land-label {
+  font-size: 11px;
+  letter-spacing: 0.25em;
+  text-transform: uppercase;
+  color: var(--accent);
+  margin-bottom: 1.75rem;
+}
+
+.land-h2 {
+  font-family: var(--serif);
+  font-weight: 300;
+  font-size: clamp(1.9rem, 3vw, 2.6rem);
+  line-height: 1.15;
+  max-width: 22ch;
+  margin-bottom: 1.5rem;
+}
+
+.land-h2 em {
+  font-style: italic;
+}
+
+.land-h3 {
+  font-family: var(--serif);
+  font-weight: 400;
+  font-size: 1.4rem;
+  line-height: 1.25;
+  margin-bottom: 0.75rem;
+}
+
+.land-head {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
+  gap: 3rem;
+  align-items: end;
+  margin-bottom: 3.5rem;
+}
+
+.land-head-intro {
+  color: var(--muted);
+  font-size: 0.95rem;
+  line-height: 1.8;
+  font-weight: 300;
+  padding-bottom: 0.35rem;
+}
+
+.land-head--stack {
+  grid-template-columns: minmax(0, 1fr);
+  gap: 1.25rem;
+  margin-bottom: 2.5rem;
+}
+
+/* ==========================================================================
+   PROSE
+   ========================================================================== */
+
+.land-prose {
+  color: var(--muted);
+  font-size: 1rem;
+  line-height: 1.85;
+  font-weight: 300;
+  max-width: 68ch;
+}
+
+.land-prose + .land-prose {
+  margin-top: 1.25rem;
+}
+
+.land-prose strong {
+  color: var(--text);
+  font-weight: 400;
+}
+
+.land-prose a {
+  color: var(--accent);
+  text-decoration: underline;
+  text-underline-offset: 4px;
+}
+
+/* ==========================================================================
+   ANSWER BOX — the GEO/AI snippet block
+   ========================================================================== */
+
+.land-answer {
