+}
+
+/* Review rows (guest reviews) */
+.land-review {
+  border-top: 1px solid var(--border);
+  padding: 2rem 0;
+}
+
+.land-review:last-child {
+  border-bottom: 1px solid var(--border);
+}
+
+.land-review q {
+  font-family: var(--serif);
+  font-size: 1.2rem;
+  font-style: italic;
+  font-weight: 400;
+  color: var(--text);
