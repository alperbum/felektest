+    padding: 0 1.5rem;
+  }
+
+  .land-page {
+    padding-top: 5rem;
+  }
+
+  .land-section {
+    padding: 3.5rem 0;
+  }
+
+  .land-head {
+    grid-template-columns: minmax(0, 1fr);
+    gap: 1.25rem;
+    align-items: start;
+    margin-bottom: 2.5rem;
+  }
+
+  .land-title {
+    max-width: none;
