+}
+
+.land-note strong {
+  color: var(--text);
+  font-weight: 400;
+}
+
+/* ==========================================================================
+   FAQ — native <details>, so the answers stay in the DOM for crawlers
+   ========================================================================== */
+
+.land-faq {
