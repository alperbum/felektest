+  // loader: jsdom'un resource loader'i yok; scriptleri elle enjekte ediyoruz
+  window.__load = rel => {
+    const el = document.createElement('script');
+    el.textContent = fs.readFileSync(path.join(ROOT, rel), 'utf8');
+    document.body.appendChild(el);
