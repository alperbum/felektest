<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- IIS Statik ve Dinamik Gzip/Deflate Sıkıştırmayı Aktif Et -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />
        <rewrite>
            <rules>
                <!-- Non-WWW'den WWW'li domaine 301 SEO Yönlendirmesi -->
                <rule name="CanonicalWWW" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTP_HOST}" pattern="^felekmangalbasi\.com$" />
                    </conditions>
                    <action type="Redirect" url="https://www.felekmangalbasi.com/{R:1}" redirectType="Permanent" />
                </rule>

                <!-- Eski AI sayfalarını yeni temiz isimlere yönlendir (301 Redirect) -->
                <rule name="RedirectOldAIPages" stopProcessing="true">
                    <match url="^ai-(.*)$" />
                    <action type="Redirect" url="{R:1}" redirectType="Permanent" />
                </rule>

                <!-- Eski sistemden kalan menu7681 vb. URL'leri /menu'ye yönlendir -->
                <rule name="RedirectLegacyMenu" stopProcessing="true">
                    <match url="^menu[0-9]+\.html$" />
                    <action type="Redirect" url="menu" redirectType="Permanent" />
                </rule>

                <!-- HTML uzantılarını gizle (örn: /menu yazınca menu.html çalışsın) -->
                <rule name="HideHTML" stopProcessing="true">
                    <match url="^(.*)$" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
                    </conditions>
                    <action type="Rewrite" url="{R:1}.html" />
                </rule>
                
                <!-- .html içeren istekleri uzantısız adrese yönlendir (Google doğrulama dosyaları hariç) -->
                <rule name="RedirectHTML" stopProcessing="true">
                    <match url="^(.*)\.html$" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_METHOD}" pattern="^POST$" negate="true" />
                        <add input="{REQUEST_URI}" pattern="^/google.*\.html$" negate="true" />
                    </conditions>
                    <action type="Redirect" url="{R:1}" redirectType="Permanent" />
                </rule>
            </rules>
        </rewrite>
        <staticContent>
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
        </staticContent>
    </system.webServer>
</configuration>
