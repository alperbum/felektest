# =============================================================================
# Felek Mangalbaşı — yerel yapılandırma örneği
# -----------------------------------------------------------------------------
# KULLANIM:  cp .env.example .env   ve gerçek değerleri yazın.
# .env dosyası .gitignore içindedir; depoya GİRMEZ.
#
# Alternatif: bu anahtarları ortam değişkeni olarak tanımlayabilirsiniz
# (ortam değişkeni .env'den önceliklidir).
# =============================================================================

# --- FTP dağıtımı (deploy_ftp.py) --------------------------------------------
FTP_HOST=
FTP_USER=
FTP_PASS=

# --- Telegram geri bildirim köprüsü (api/feedback.php) ------------------------
# Token BotFather'dan alınır. SUNUCU TARAFINDA kalır, istemciye asla gitmez.
# DİKKAT: Eylül 2026'ya kadar bu token js kaynağında düz metin olarak
# yayındaydı. BotFather > /revoke ile YENİLEYİN, sonra yeni değeri buraya yazın.
TG_BOT_TOKEN=
TG_CHAT_ID=
